{
  "name": "bit-by-ear",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0 <23.0.0" },
  "scripts": {
    "dev": "node --import tsx src/server/dev.ts",
    "dev:web": "node --watch --import tsx src/server/main.ts",
    "dev:worker": "node --watch --import tsx src/server/worker.ts",
    "build": "npm run typecheck && vite build",
    "start": "node dist/server/main.js",
    "start:worker": "node dist/server/worker.js",
    "db:migrate": "node --import tsx src/server/migrate.ts",
    "local:setup": "docker compose up -d postgres && npm run db:migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "*",
    "date-fns-tz": "*",
    "dotenv": "*",
    "express": "*",
    "lucide-react": "*",
    "music-metadata": "*",
    "multer": "2.5.0",
    "pdfjs-dist": "*",
    "pg": "*",
    "react": "*",
    "react-aria-components": "*",
    "react-dom": "*",
    "react-hook-form": "*",
    "react-router-dom": "*",
    "web-push": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@playwright/test": "*",
    "@types/express": "*",
    "@types/multer": "2.3.0",
    "@types/node": "*",
    "@types/pg": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@types/web-push": "*",
    "@vitejs/plugin-react": "*",
    "jsdom": "*",
    "tsx": "*",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  }
}
