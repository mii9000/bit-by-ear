NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://bitbyeardev:bitbyeardev@localhost:5432/bitbyeardev
# Development is usable with deterministic mock providers. Set to real to use API keys.
PROVIDER_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-12b-it
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: without these, audio remains available and push is disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# The development server supplies an ephemeral local-only secret if this is empty.
SESSION_SECRET=
